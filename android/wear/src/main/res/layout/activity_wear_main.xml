<?xml version="1.0" encoding="utf-8"?>
<!--
  BoxInsetLayout = zona segura en dial redondo.
  ScrollView + minHeight dinámico = centra si cabe; scrollea si no (chin / SOS activo).
-->
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootInset"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_boxedEdges="all">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/wear_pad_h"
            android:paddingTop="@dimen/wear_pad_v"
            android:paddingEnd="@dimen/wear_pad_h"
            android:paddingBottom="@dimen/wear_pad_v">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="@dimen/wear_title"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnSos"
                android:layout_width="@dimen/wear_sos_default"
                android:layout_height="@dimen/wear_sos_default"
                android:layout_marginTop="@dimen/wear_gap"
                android:background="@drawable/bg_wear_sos_btn"
                android:clickable="true"
                android:contentDescription="@string/sos_help"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/txtSosLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/sos"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/wear_sos_text"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/wear_gap"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/status_idle"
                android:textColor="#C5D5D8"
                android:textSize="@dimen/wear_status" />

            <TextView
                android:id="@+id/txtVitals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_wear_chip"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/vitals_na"
                android:textColor="@color/wear_teal"
                android:textSize="@dimen/wear_vitals" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImOk"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wear_btn_ok_h"
                android:layout_marginTop="@dimen/wear_gap"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="@string/im_ok"
                android:textAllCaps="false"
                android:textColor="@color/wear_teal"
                android:textSize="11sp"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:rippleColor="@color/wear_teal"
                app:strokeColor="@color/wear_teal"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
